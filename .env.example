# Copy this file to .env and fill it in, then run:  npm run setup

# Create at https://supabase.com/dashboard/account/tokens  ("Generate new token")
SUPABASE_ACCESS_TOKEN=

# The login you will use on the website to add / edit stories
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: use a project you already created instead of making a new one
# (the ref is the part before .supabase.co in your project URL)
SUPABASE_PROJECT_REF=

# Optional: region for a new project (ap-south-1 = Mumbai)
SUPABASE_REGION=ap-south-1
